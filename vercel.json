{
  "buildCommand": "cd client && npm install && npm run build",
  "outputDirectory": "client/dist",
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/delivery",
      "destination": "/delivery.html"
    },
    {
      "source": "/delivery/:match*",
      "destination": "/delivery.html"
    },
    {
      "source": "/admin",
      "destination": "/admin.html"
    },
    {
      "source": "/admin/:match*",
      "destination": "/admin.html"
    },
    {
      "source": "/((?!api/.*).*)",
      "destination": "/index.html"
    }
  ]
}
